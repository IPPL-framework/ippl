# Focused ChDR documentation. Run from this directory: doxygen Doxyfile
# The explicit input list keeps IPPL dependencies, generated viewers, data and
# historical handoff notes out of the student API reference.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "ChDR mesh-1: student guide"
PROJECT_BRIEF          = "Geometry, distributed material fields, diagnostics and tests"
OUTPUT_DIRECTORY       = docs
INPUT                  = StudentGuide.md Documentation.dox \
                         ChdrMeshConfig.h PrismGeometry.h BrickGeometry.h \
                         mesh-1.cpp MaterialViewer.h MeshVisualization.h \
                         test_geometry.cpp verify_mesh_output.py
INPUT_ENCODING         = UTF-8
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE  = StudentGuide.md
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS    = 3
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

# Include internal orchestration functions so students can follow the program.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES    = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
JAVADOC_AUTOBRIEF      = YES
PYTHON_DOCSTRING       = NO
SORT_MEMBER_DOCS       = NO
SHOW_USED_FILES        = YES

# Parse this directory without recursively preprocessing all of IPPL/Kokkos.
ENABLE_PREPROCESSING   = YES
SEARCH_INCLUDES        = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = KOKKOS_INLINE_FUNCTION= "KOKKOS_LAMBDA=[]"

# Warnings make incomplete/broken documentation visible to maintainers.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

# Graphviz diagrams and locally rendered formulas need no browser CDN.
# Formula images use latex, dvips and Ghostscript when formulas are present.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 30
DOT_NUM_THREADS        = 1
USE_MATHJAX            = NO
