# Dedicated cosmology documentation. Generated config paths are set by build_documentation.py.
PROJECT_NAME = "IPPL Cosmology"
PROJECT_BRIEF = "Physical model, numerical operators, APIs and validation contracts"
OUTPUT_DIRECTORY = "@OUTPUT_ROOT@"
INPUT = "@SOURCE_ROOT@" "@MANUAL_ROOT@"
FILE_PATTERNS = *.h *.hpp *.c *.cpp *.py *.dox
RECURSIVE = YES
EXCLUDE_PATTERNS = */results/* */ippl-cosmology-paper/* */__pycache__/*
EXAMPLE_PATH = "@SOURCE_ROOT@/reference" "@SOURCE_ROOT@/merlin" "@SOURCE_ROOT@/gadget2"
EXAMPLE_RECURSIVE = YES
STRIP_FROM_PATH = "@SOURCE_ROOT@" "@MANUAL_ROOT@"
FULL_PATH_NAMES = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
EXTRACT_ANON_NSPACES = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
WARN_LOGFILE = "@OUTPUT_ROOT@/warnings.log"
QUIET = YES
GENERATE_HTML = YES
HTML_COLORSTYLE = LIGHT
GENERATE_TREEVIEW = YES
SEARCHENGINE = YES
GENERATE_XML = YES
GENERATE_LATEX = NO
GENERATE_TAGFILE = "@OUTPUT_ROOT@/cosmology.tag"
SOURCE_BROWSER = YES
INLINE_SOURCES = NO
STRIP_CODE_COMMENTS = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION = YES
AUTOLINK_SUPPORT = NO
MAX_INITIALIZER_LINES = 0
PYTHON_DOCSTRING = YES
FILTER_PATTERNS = *.py="@FILTER_COMMAND@"
FILTER_SOURCE_FILES = NO
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
PREDEFINED = KOKKOS_INLINE_FUNCTION=inline KOKKOS_LAMBDA=[=] FASTPM_REFERENCE_COMMIT="15b6c4fd7502a81d99dd13f54fcc9cfa44be1331"
USE_MATHJAX = @USE_MATHJAX@
HTML_FORMULA_FORMAT = svg
EXTRA_PACKAGES = amsmath amssymb
MATHJAX_VERSION = MathJax_3
MATHJAX_FORMAT = SVG
CITE_BIB_FILES = "@MANUAL_ROOT@/references.bib"
HAVE_DOT = @HAVE_DOT@
DOT_IMAGE_FORMAT = svg
INTERACTIVE_SVG = YES
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
INCLUDE_GRAPH = YES
INCLUDED_BY_GRAPH = YES
