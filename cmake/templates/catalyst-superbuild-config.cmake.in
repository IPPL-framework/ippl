# Shim catalyst package for ippl superbuilds.
#
# catalyst::catalyst is already defined by the time AdiosCatalyst is added, either by the in-tree
# FetchContent build or by ippl importing an external install. Re-running the upstream
# catalyst-config.cmake would try to import those targets a second time, so only re-expose the
# version, the FOUND flags and the SDK macros here.

set(CATALYST_VERSION "@CATALYST_VERSION@")
set(CATALYST_ABI_VERSION "2")

if(NOT TARGET catalyst::catalyst)
  set("${CMAKE_FIND_PACKAGE_NAME}_FOUND" 0)
  set("${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE"
      "ippl catalyst shim: expected the catalyst::catalyst target to already exist.")
  return()
endif()

set("${CMAKE_FIND_PACKAGE_NAME}_FOUND" 1)

if("SDK" IN_LIST "${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS")
  # catalyst-macros.cmake resolves catalyst_impl.{c,h}.in relative to its own location, so include
  # it from the real package directory instead of copying it.
  include("@CATALYST_MACROS_DIR@/catalyst-macros.cmake")
  set("${CMAKE_FIND_PACKAGE_NAME}_SDK_FOUND" 1)
endif()
