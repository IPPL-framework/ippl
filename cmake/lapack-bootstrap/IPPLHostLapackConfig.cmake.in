if(NOT TARGET IPPLHostLapack::lapacke)
  get_filename_component(_ipplLapackPrefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
  add_library(IPPLHostLapack::lapacke INTERFACE IMPORTED)
  set_target_properties(IPPLHostLapack::lapacke PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_ipplLapackPrefix}/include/ippl-lapack"
    INTERFACE_LINK_LIBRARIES "${_ipplLapackPrefix}/lib/ippl-lapack/@IPPL_LAPACKE_FILE@;${_ipplLapackPrefix}/lib/ippl-lapack/@IPPL_LAPACK_FILE@;${_ipplLapackPrefix}/lib/ippl-lapack/@IPPL_BLAS_FILE@;@IPPL_LAPACK_RUNTIME_LIBRARIES@")
  if("@IPPL_LAPACK_INTEGER_BYTES@" STREQUAL "8")
    set_property(TARGET IPPLHostLapack::lapacke PROPERTY INTERFACE_COMPILE_DEFINITIONS LAPACK_ILP64)
  endif()
  unset(_ipplLapackPrefix)
endif()
